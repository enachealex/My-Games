/* Graveway's screens: the CSS in graveway/index.html, ported to UI Toolkit.
   Sizes are in points on a 390 x 844 reference screen (the PanelSettings
   scales them). What USS can't do (gradients, keyframe animations, grid)
   is done in code: see Hud*.cs.

   Colours, as in the web version:
     bg #0d1418   panel rgba(14,20,24,.86)   panel-solid #121a1f   line rgba(255,255,255,.1)
     text #eef2ec dim #9aa6a0   accent #9be15d   accent-ink #0f1a08
     blood #ff4d4d   armor #5db4ff   gold #ffc928                         */

.gw-root { flex-grow: 1; color: rgb(238, 242, 236); font-size: 15px; }
/* The theme pads and spaces every label; this takes that off. As specific
   as the theme's own rule and no more, so the class rules below win. */
.unity-label { padding: 0; margin: 0; }

/* ── Shared ───────────────────────────────────────────────────────────── */
.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.dim { color: rgb(154, 166, 160); }
.accent { color: rgb(155, 225, 93); }
.display { -unity-font-style: bold; letter-spacing: 2px; }
.small-caps { font-size: 11px; letter-spacing: 1.5px; color: rgb(154, 166, 160); -unity-font-style: bold; }

.btn {
    min-height: 48px; margin: 0; padding: 0 20px; border-radius: 14px; border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1); background-color: rgba(255, 255, 255, 0.06);
    color: rgb(238, 242, 236); font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center;
    transition-property: scale, background-color; transition-duration: 0.08s, 0.15s;
}
.btn:hover { background-color: rgba(255, 255, 255, 0.1); }
.btn:active { scale: 0.97 0.97; }
.btn.primary { background-color: rgb(155, 225, 93); color: rgb(15, 26, 8); border-color: rgba(0, 0, 0, 0); }
.btn.primary:hover { background-color: rgb(174, 240, 111); }
.btn.big { min-height: 60px; font-size: 26px; letter-spacing: 3px; }
.btn.small { min-height: 40px; padding: 0 14px; border-radius: 11px; font-size: 14px; }
.btn.wide { margin-top: 14px; }
.btn.off { opacity: 0.45; }
.btn.note-btn { color: rgb(154, 166, 160); font-size: 14px; min-height: 42px; }
.stack > .btn, .stack > .row-btns, .stack > .toggle { margin-top: 10px; }
.row-btns { flex-direction: row; margin-left: -5px; margin-right: -5px; }
.row-btns > .btn { flex-grow: 1; flex-basis: 0; margin-left: 5px; margin-right: 5px; }

.icon-btn {
    width: 44px; height: 44px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(14, 20, 24, 0.86); align-items: center; justify-content: center; padding: 0; margin: 0;
}
.icon { width: 22px; height: 22px; }
.pill {
    padding: 4px 10px; border-radius: 99px; background-color: rgba(155, 225, 93, 0.14); color: rgb(155, 225, 93);
    font-size: 12px; -unity-font-style: bold; letter-spacing: 0.5px;
}
.wallet {
    flex-direction: row; align-items: center; padding: 8px 14px; border-radius: 99px; background-color: rgba(14, 20, 24, 0.86);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); -unity-font-style: bold;
}
.coin { width: 14px; height: 14px; margin-right: 5px; }
.panel {
    padding: 16px; border-radius: 18px; background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
}
.blurb { margin: 4px 0 14px 0; color: rgb(154, 166, 160); font-size: 14px; white-space: normal; }
.fine { margin-top: 10px; font-size: 12px; color: rgb(154, 166, 160); white-space: normal; }
.need { margin-top: 8px; -unity-text-align: middle-center; font-size: 13px; color: rgb(154, 166, 160); white-space: normal; }
.portrait { border-radius: 14px; background-color: rgb(30, 42, 32); -unity-background-scale-mode: scale-and-crop; overflow: hidden;
    align-items: center; justify-content: center; }
.portrait.sm { width: 44px; height: 44px; border-radius: 12px; }
.portrait.lg { width: 210px; height: 210px; border-radius: 24px; align-self: center; margin-bottom: 8px; }
.portrait-letter { font-size: 24px; -unity-font-style: bold; color: rgb(155, 225, 93); }
.portrait.lg .portrait-letter { font-size: 80px; }

/* Stat bars: label, track, value. */
.stat { flex-direction: row; align-items: center; margin: 6px 0; }
.stat-label { width: 78px; font-size: 13px; color: rgb(154, 166, 160); }
.stat-track { flex-grow: 1; height: 8px; border-radius: 99px; background-color: rgba(255, 255, 255, 0.08); overflow: hidden; }
.stat-fill { height: 100%; border-radius: 99px; background-color: rgb(155, 225, 93); }
.stat-value { width: 96px; font-size: 13px; -unity-text-align: middle-right; -unity-font-style: bold; }

/* ── Menu ─────────────────────────────────────────────────────────────── */
.menu { justify-content: space-between; padding: 16px 16px 20px 16px; -unity-background-scale-mode: stretch-to-fill; }
.menu-top { flex-direction: row; justify-content: space-between; align-items: center; }
.title { align-items: center; margin-top: 30px; }
.title-row { flex-direction: row; }
.title-main { font-size: 96px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(233, 239, 226);
    text-shadow: 0 4px 0 rgb(58, 12, 12); }
.title-main.red { color: rgb(255, 77, 77); }
.title-sub { margin-top: 10px; color: rgb(154, 166, 160); font-size: 15px; text-shadow: 0 2px 8px rgb(0, 0, 0); }
.menu-bottom { width: 100%; max-width: 420px; align-self: center; }
.menu-bottom > * { margin-top: 10px; }
.btn.update { min-height: 44px; font-size: 14px; color: rgb(155, 225, 93); border-color: rgba(155, 225, 93, 0.5);
    background-color: rgba(155, 225, 93, 0.14); }
.menu-stats { flex-direction: row; margin-left: -5px; margin-right: -5px; }
.m-card {
    flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; padding: 10px 12px; border-radius: 18px;
    background-color: rgba(14, 20, 24, 0.86); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); min-width: 0;
}
.m-card { margin: 0 5px; }               /* they're buttons: none of a button's own margin */
.m-card:hover { background-color: rgba(24, 32, 38, 0.92); }
.m-card:active { scale: 0.98 0.98; }
.m-chev { position: absolute; right: 12px; top: 0; bottom: 0; -unity-text-align: middle-right; font-size: 24px; color: rgb(154, 166, 160); }
.m-best { flex-direction: column; align-items: flex-start; }
.m-big { font-size: 26px; -unity-font-style: bold; letter-spacing: 1px; }
.m-small { font-size: 12px; color: rgb(154, 166, 160); }
.upd-ready { border-color: rgba(255, 201, 40, 0.55); background-color: rgba(255, 201, 40, 0.12); color: rgb(255, 201, 40); }
.hint { margin-top: 4px; -unity-text-align: middle-center; font-size: 13px; color: rgb(154, 166, 160); white-space: normal; }
.badge {
    position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 99px;
    background-color: rgb(255, 201, 40); color: rgb(26, 18, 0); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center;
}

/* ── Headers (select, armory) ─────────────────────────────────────────── */
.a-head { flex-direction: row; align-items: center; padding: 12px 16px 10px 16px; }
.a-head-title { flex-grow: 1; margin-left: 12px; font-size: 30px; -unity-font-style: bold; letter-spacing: 2px; }

/* ── Survivor select ──────────────────────────────────────────────────── */
.c-wrap { flex-grow: 1; min-height: 0; overflow: hidden; }
.c-track { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.c-track.glide { transition-property: translate; transition-duration: 0.24s; transition-timing-function: ease-out-cubic; }
.c-card { position: absolute; top: 0; bottom: 0; }
.c-card.fade { transition-property: opacity, scale; transition-duration: 0.24s; }
.c-card.side { opacity: 0.4; scale: 0.94 0.94; }
.c-name { flex-direction: row; align-items: center; justify-content: space-between; }
.c-name-text { font-size: 40px; -unity-font-style: bold; letter-spacing: 1px; }
.perk {
    margin-top: 10px; padding: 10px 12px; border-radius: 12px; background-color: rgba(155, 225, 93, 0.07);
    border-width: 1px; border-color: rgba(155, 225, 93, 0.18);
}
.perk-name { font-size: 15px; -unity-font-style: bold; }
.perk-text { font-size: 13px; color: rgb(207, 216, 210); white-space: normal; }
.perk-boost { font-size: 12px; -unity-font-style: bold; color: rgb(155, 225, 93); white-space: normal; }
.perk.gunline { flex-direction: row; align-items: center; background-color: rgba(255, 255, 255, 0.04); border-color: rgba(255, 255, 255, 0.1); }
.gun-icon { width: 64px; height: 24px; margin-right: 12px; }
.perk.hatline { margin-top: 6px; }
.perk.gunline .perk-name { white-space: normal; }
.c-foot { align-items: center; padding: 12px 16px 18px 16px; }
.c-dots { flex-direction: row; margin-bottom: 12px; }
.c-dot { width: 12px; height: 12px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.2); margin: 0 4px; padding: 0; border-width: 0; }
.c-dot.locked { background-color: rgba(255, 255, 255, 0.08); }
.c-dot.on { width: 28px; background-color: rgb(155, 225, 93); }
.c-foot > .btn { width: 100%; max-width: 420px; }
.c-buy { flex-direction: row; justify-content: center; align-items: center; }
.c-buy-label { margin-right: 14px; }
.c-buy .coin { width: 22px; height: 22px; margin-right: 6px; }
.portrait.locked { -unity-background-image-tint-color: rgb(96, 104, 100); }

/* ── Armory ───────────────────────────────────────────────────────────── */
.armory { background-color: rgba(9, 13, 16, 0.94); }
.tabs { flex-direction: row; margin: 0 16px 8px 16px; padding: 4px; border-radius: 14px; background-color: rgba(255, 255, 255, 0.05); }
.tab { flex-grow: 1; flex-basis: 0; min-height: 42px; border-width: 0; border-radius: 10px; background-color: rgba(0, 0, 0, 0);
    color: rgb(154, 166, 160); -unity-font-style: bold; margin: 0; }
.tab.on { background-color: rgba(255, 255, 255, 0.1); color: rgb(238, 242, 236); }
.a-body { flex-grow: 1; }
.a-content { padding: 6px 16px 24px 16px; }
.wgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 4px; }
.wcard {
    width: 31.5%; margin: 0 0 8px 0; padding: 10px; border-radius: 14px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.04); align-items: flex-start;
}
.wcard.sel { border-color: rgb(155, 225, 93); background-color: rgba(155, 225, 93, 0.08); }
.wcard .gun-icon { width: 100%; height: 26px; margin: 0 0 2px 0; }
.wn { font-size: 14px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
.wn.long { white-space: normal; font-size: 13px; -unity-text-align: upper-left; }
.wt { font-size: 12px; color: rgb(154, 166, 160); -unity-font-style: bold; flex-direction: row; align-items: center; }
.wcard.eq .wt { color: rgb(155, 225, 93); }
.wsig { font-size: 11px; color: rgb(155, 225, 93); -unity-font-style: bold; }
.loadout { margin-bottom: 12px; }
.lo-slots { flex-direction: row; margin-top: 6px; }
.lo-slot {
    flex-grow: 1; flex-basis: 0; min-height: 58px; padding: 6px 4px; margin: 0 3px; border-radius: 12px; border-width: 1px;
    border-color: rgba(155, 225, 93, 0.35); background-color: rgba(155, 225, 93, 0.08); align-items: center; justify-content: center;
}
.lo-slot .gun-icon { width: 44px; height: 16px; margin: 0 0 3px 0; }
.lo-slot-label { font-size: 11px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
.lo-slot.own { border-color: rgba(255, 255, 255, 0.1); background-color: rgba(255, 255, 255, 0.05); }
.lo-slot.own .lo-slot-label, .lo-slot.empty .lo-slot-label { color: rgb(154, 166, 160); }
.lo-slot.empty { border-color: rgba(255, 255, 255, 0.1); background-color: rgba(0, 0, 0, 0); }
.wd-head { flex-direction: row; align-items: center; justify-content: space-between; }
.wd-title { font-size: 28px; -unity-font-style: bold; letter-spacing: 1px; }
.gunpic { height: 150px; margin: 2px 0 6px 0; -unity-background-scale-mode: scale-to-fit; }
.h4 { margin: 18px 0 4px 0; font-size: 12px; letter-spacing: 1.5px; color: rgb(154, 166, 160); -unity-font-style: bold; }
.slotrow {
    flex-direction: row; align-items: center; min-height: 48px; padding: 0 14px; margin: 0 0 6px 0; border-radius: 12px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); background-color: rgba(255, 255, 255, 0.04);
}
.slotrow.open { border-color: rgb(155, 225, 93); background-color: rgba(155, 225, 93, 0.07); }
.slot-name { width: 92px; font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: rgb(154, 166, 160); }
.slot-part { flex-grow: 1; font-size: 14px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.slot-arrow { font-size: 14px; color: rgb(154, 166, 160); }
.partlist { padding: 2px 0 6px 10px; margin-left: 6px; border-left-width: 2px; border-color: rgba(155, 225, 93, 0.3); }
.part {
    flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 6px; border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.25); border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
}
.part.on { border-color: rgba(155, 225, 93, 0.45); }
.pt { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 10px; }
.pt-name { font-size: 14px; -unity-font-style: bold; }
.pt-blurb { font-size: 12px; color: rgb(154, 166, 160); white-space: normal; }
.fx { flex-direction: row; flex-wrap: wrap; margin-top: 2px; }
.fx-chip { font-size: 11px; -unity-font-style: bold; padding: 2px 7px; border-radius: 99px; margin: 2px 4px 0 0; }
.fx-chip.up { background-color: rgba(155, 225, 93, 0.14); color: rgb(155, 225, 93); }
.fx-chip.down { background-color: rgba(255, 77, 77, 0.13); color: rgb(255, 138, 138); }
.part > .btn { min-width: 84px; }
.uprow { flex-direction: row; align-items: center; justify-content: space-between; padding: 12px 0; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.1); }
.ul { flex-shrink: 1; min-width: 0; }
.ul-label { -unity-font-style: bold; }
.ul-sub { font-size: 12px; color: rgb(154, 166, 160); }
.pips { flex-direction: row; margin-top: 4px; }
.pip { width: 18px; height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.12); margin-right: 4px; }
.pip.on { background-color: rgb(155, 225, 93); }
.uprow > .btn { min-width: 92px; }

/* ── Black Market ───────────────────────────────────────────────────── */
.bm-item { margin-bottom: 10px; padding: 14px; }
.bm-row { flex-direction: row; align-items: center; }
.item-icon { width: 44px; height: 44px; margin-right: 12px; flex-shrink: 0; }
.item-icon-sm { width: 26px; height: 26px; margin: 0 0 2px 0; }
.bm-words { flex-grow: 1; flex-shrink: 1; margin-right: 10px; }
.bm-name { font-size: 16px; -unity-font-style: bold; }
.bm-blurb { font-size: 13px; color: rgb(154, 166, 160); white-space: normal; margin-top: 2px; }
.bm-have { font-size: 12px; color: rgb(155, 225, 93); -unity-font-style: bold; margin-top: 4px; }

/* ── HUD ──────────────────────────────────────────────────────────────── */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.h-top { flex-direction: row; align-items: center; padding: 10px 12px 0 12px; }
.h-dist { font-size: 30px; -unity-font-style: bold; padding: 6px 10px; border-radius: 10px; background-color: rgba(14, 20, 24, 0.86);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); margin-right: 10px; }
.h-stage { flex-grow: 1; margin-right: 10px; }
.h-stage-label { font-size: 11px; color: rgb(155, 225, 93); -unity-font-style: bold; letter-spacing: 1.5px; margin-bottom: 4px;
    text-shadow: 0 1px 4px rgb(0, 0, 0); }
.h-prog { height: 8px; border-radius: 99px; background-color: rgba(0, 0, 0, 0.45); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); overflow: hidden; }
.h-prog-fill { height: 100%; width: 100%; background-color: rgb(155, 225, 93); transform-origin: left; }
.h-coins { flex-direction: row; align-items: center; -unity-font-style: bold; padding: 6px 10px; border-radius: 10px;
    background-color: rgba(14, 20, 24, 0.86); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); margin-right: 10px; }
.h-kills { position: absolute; left: 12px; top: 84px; font-size: 12px; -unity-font-style: bold; color: rgb(154, 166, 160);
    text-shadow: 0 1px 4px rgb(0, 0, 0); }
.h-debug { position: absolute; left: 12px; top: 100px; font-size: 11px; -unity-font-style: bold; color: rgb(255, 209, 102);
    text-shadow: 0 1px 4px rgb(0, 0, 0); }
.h-boss { position: absolute; left: 27%; right: 27%; top: 62px; align-items: center; }   /* clear of the kills on the left */
.h-boss-label { font-size: 15px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(255, 154, 138); text-shadow: 0 2px 6px rgb(0, 0, 0); }
.h-boss-pips { flex-direction: row; margin-top: 4px; }
.h-boss-pip { width: 22px; height: 7px; margin: 0 3px; border-radius: 2px; border-width: 1px; border-color: rgba(200, 206, 212, 0.6);
    background-color: rgba(0, 0, 0, 0.4); }
.h-boss-pip.on { background-color: rgb(170, 178, 186); }
.h-boss-bar { width: 100%; height: 10px; margin-top: 4px; border-radius: 99px; background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px; border-color: rgba(255, 80, 80, 0.4); overflow: hidden; }
.h-boss-fill { height: 100%; width: 100%; background-color: rgb(255, 77, 77); transform-origin: left; }
.h-bottom { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; align-items: flex-end; justify-content: space-between;
    padding: 0 12px 14px 12px; }
.vitals { width: 46%; }
.vitals > * { margin-top: 6px; }
.h-buffs { flex-direction: row; flex-wrap: wrap; }
.buff { flex-direction: row; align-items: center; padding: 3px 9px 3px 3px; margin: 0 6px 0 0; border-radius: 99px; overflow: hidden;
    background-color: rgba(14, 20, 24, 0.86); border-width: 1px; -unity-font-style: bold; font-size: 14px; }
.buff-icon { width: 24px; height: 24px; margin-right: 4px; }
.buff-fill { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; transform-origin: left; }
.h-face .portrait { width: 52px; height: 52px; border-width: 2px; border-color: rgba(155, 225, 93, 0.5); }
.vbar { flex-direction: row; align-items: center; }
.vbar-icon { width: 16px; height: 16px; margin-right: 8px; }
.vbar-track { flex-grow: 1; height: 14px; border-radius: 6px; background-color: rgba(0, 0, 0, 0.5); border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1); overflow: hidden; }
.vbar-track.thin { height: 9px; }
.vbar-fill { height: 100%; width: 100%; transform-origin: left; }
.vbar-fill.hp { background-color: rgb(255, 77, 77); }
.vbar-fill.armor { background-color: rgb(93, 180, 255); }
.vbar-n { min-width: 30px; margin-left: 8px; font-size: 14px; -unity-font-style: bold; text-shadow: 0 1px 4px rgb(0, 0, 0); }
.weap { align-items: flex-end; }
.wbar { align-items: flex-end; }
.wbtn { width: 64px; height: 40px; margin-bottom: 6px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(14, 20, 24, 0.86); align-items: center; justify-content: center; overflow: hidden; }
.wbtn .gun-icon { width: 46px; height: 18px; margin: 0; }
.wbtn-ammo { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background-color: rgba(255, 255, 255, 0.35); transform-origin: left; }
.wbtn-n { position: absolute; left: 5px; top: 2px; font-size: 9px; -unity-font-style: bold; color: rgb(154, 166, 160); }
.wbtn.on { border-color: rgb(155, 225, 93); background-color: rgba(30, 46, 22, 0.92); }
.wbtn.on .wbtn-ammo { background-color: rgb(155, 225, 93); }
.wcard-hud { min-width: 132px; padding: 10px 14px; border-radius: 16px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(14, 20, 24, 0.86); align-items: flex-end; overflow: hidden; }
.wname { font-size: 12px; -unity-font-style: bold; color: rgb(154, 166, 160); letter-spacing: 1px; }
.ammo-row { flex-direction: row; align-items: flex-end; }
.ammo { font-size: 34px; -unity-font-style: bold; }
.mag { font-size: 14px; color: rgb(154, 166, 160); margin-left: 4px; margin-bottom: 5px; }
.wcard-hud.empty .ammo { color: rgb(255, 77, 77); }
.wcard-hud.reloading .ammo { color: rgb(155, 225, 93); }
.tap { font-size: 10px; color: rgb(154, 166, 160); letter-spacing: 1px; margin-top: 2px; }
.reload-fill { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background-color: rgb(155, 225, 93); transform-origin: left; }

.stick-base { position: absolute; border-radius: 999px; border-width: 2px; border-color: rgba(255, 255, 255, 0.22); background-color: rgba(255, 255, 255, 0.05); }
.stick-knob { position: absolute; border-radius: 999px; background-color: rgba(255, 255, 255, 0.28); border-width: 2px; border-color: rgba(255, 255, 255, 0.45); }
.vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; -unity-background-scale-mode: stretch-to-fill; }

.banner { position: absolute; left: 0; right: 0; top: 30%; align-items: center;
    transition-property: scale, opacity; transition-duration: 0.35s; transition-timing-function: ease-out-back; }
.banner-t { font-size: 54px; -unity-font-style: bold; letter-spacing: 2px; -unity-text-align: middle-center; white-space: normal;
    text-shadow: 0 4px 0 rgba(60, 10, 10, 0.9); }
.banner-s { margin-top: 6px; -unity-font-style: bold; color: rgb(213, 221, 210); text-shadow: 0 2px 6px rgb(0, 0, 0);
    -unity-text-align: middle-center; white-space: normal; padding: 0 20px; }
.toast { position: absolute; top: 96px; left: 0; right: 0; align-items: center; }
.toast-pill { padding: 6px 14px; border-radius: 99px; background-color: rgba(14, 20, 24, 0.86); border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1); -unity-font-style: bold; -unity-text-align: middle-center;
    transition-property: translate, opacity; transition-duration: 0.2s; }
.toast.over-modal { top: 18px; }             /* in the modal's room at the top, clear of its card */
.toast-pill.power { font-size: 22px; letter-spacing: 1px; padding: 4px 16px; }

/* ── Modals ───────────────────────────────────────────────────────────── */
.modal { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 64px 20px 20px 20px; background-color: rgba(5, 8, 10, 0.66);
    align-items: center; justify-content: center; }
.card { width: 100%; max-width: 380px; max-height: 100%; padding: 22px; border-radius: 22px; background-color: rgb(18, 26, 31);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1); }
.card-scroll { flex-shrink: 1; }
.card-title { font-size: 42px; -unity-font-style: bold; letter-spacing: 2px; -unity-text-align: middle-center; }
.card-title.red { color: rgb(255, 77, 77); }
.card-sub { margin: 6px 0 16px 0; color: rgb(154, 166, 160); -unity-text-align: middle-center; white-space: normal; }
.card-sub.gold { color: rgb(255, 201, 40); -unity-font-style: bold; letter-spacing: 1px; }
.card-sub.ctx { font-size: 12px; }
.r-dist { font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center; margin-top: 4px; }
.r-row { flex-direction: row; justify-content: space-between; padding: 9px 0; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.1); }
.r-row.total { border-bottom-width: 0; font-size: 18px; }
.r-row-k { color: rgb(154, 166, 160); }
.r-row.total .r-row-k { color: rgb(238, 242, 236); -unity-font-style: bold; }
.r-row-v { flex-direction: row; align-items: center; -unity-font-style: bold; }
.r-wallet { margin-top: 8px; font-size: 13px; color: rgb(154, 166, 160); flex-direction: row; justify-content: center; align-items: center; }
.r-wallet .coin { margin: 0 4px; }
.r-tip { margin-top: 14px; padding: 10px 12px; border-radius: 12px; background-color: rgba(255, 255, 255, 0.05);
    font-size: 13px; color: rgb(207, 216, 210); white-space: normal; -unity-text-align: middle-center; }
.toggle {
    flex-direction: row; justify-content: space-between; align-items: center; min-height: 54px; padding: 0 16px; margin: 0;
    border-radius: 14px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); background-color: rgba(255, 255, 255, 0.04);
    -unity-font-style: bold; color: rgb(238, 242, 236);
}
.toggle-value { -unity-font-style: bold; color: rgb(154, 166, 160); }
.toggle.on .toggle-value { color: rgb(155, 225, 93); }
.s-head { margin-top: 20px; font-size: 12px; letter-spacing: 1.5px; color: rgb(154, 166, 160); -unity-font-style: bold; }
.danger { color: rgb(255, 138, 138); }
.danger.armed { background-color: rgba(255, 77, 77, 0.16); border-color: rgba(255, 77, 77, 0.5); }
.credits { margin-top: 16px; font-size: 12px; color: rgb(154, 166, 160); white-space: normal; -unity-text-align: middle-center; }
.chips { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 12px; }
.chip-btn { min-height: 36px; padding: 0 12px; margin: 3px; border-radius: 99px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.05); font-size: 13px; -unity-font-style: bold; color: rgb(238, 242, 236); }
.chip-btn.on { background-color: rgb(155, 225, 93); color: rgb(15, 26, 8); border-color: rgba(0, 0, 0, 0); }
.note-text { margin: 0 0 12px 0; min-height: 96px; }
/* Typing on a phone: the note above the keyboard, with only what's needed. */
.modal.typing { padding-top: 20px; }
.modal.typing .card-title, .modal.typing .ctx { display: none; }
.note-text > .unity-text-field__input { padding: 12px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.35); color: rgb(238, 242, 236); font-size: 14px; white-space: normal; -unity-text-align: upper-left; }
.notes-text { margin: 0; height: 220px; }
.notes-text > .unity-text-field__input { padding: 12px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.35); color: rgb(207, 216, 210); font-size: 12px; white-space: normal; -unity-text-align: upper-left; }

/* ── Bebas Neue, wherever the web version uses it (its var(--display)) ─── */
.display, .btn.big, .title-main, .m-big, .portrait-letter, .a-head-title, .c-name-text, .wd-title,
.h-dist, .h-boss-label, .ammo, .banner-t, .toast-pill.power, .card-title, .r-dist, .riser-text {
    -unity-font-definition: url("Fonts/BebasNeue-Regular.ttf");
    -unity-font-style: normal;
}

/* The backpack in a run: the Black Market's items, on the left edge, above
   your health, within thumb reach. */
.h-pack { position: absolute; left: 12px; bottom: 200px; }
.pack-btn { width: 56px; height: 56px; margin-top: 8px; border-radius: 14px; border-width: 1px; border-color: rgba(155, 225, 93, 0.55);
    background-color: rgba(14, 20, 24, 0.86); align-items: center; justify-content: center; }
.pack-btn.busy { opacity: 0.4; }
.pack-btn > .item-icon { width: 34px; height: 34px; margin-right: 0; }
.pack-n { position: absolute; right: 4px; bottom: 2px; font-size: 13px; -unity-font-style: bold; }
.pack-t { position: absolute; left: 0; right: 0; top: -17px; font-size: 12px; -unity-font-style: bold; color: rgb(155, 225, 93);
    -unity-text-align: middle-center; text-shadow: 0 1px 4px rgb(0, 0, 0); }

/* ── Scoreboard ───────────────────────────────────────────────────────── */
.r-board { margin-top: 16px; }
.r-board-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.r-rank { font-size: 15px; -unity-font-style: bold; color: rgb(155, 225, 93); }
.r-online { font-size: 12px; color: rgb(154, 166, 160); margin-top: 2px; }
.name-field { margin: 0; }
.name-field > .unity-text-field__input { min-height: 46px; padding: 0 14px; border-radius: 12px; border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14); background-color: rgba(0, 0, 0, 0.35); color: rgb(238, 242, 236);
    font-size: 17px; -unity-font-style: bold; }
.name-chips { flex-direction: row; flex-wrap: wrap; }
.btn.chip { min-height: 34px; padding: 0 12px; border-radius: 99px; font-size: 13px; margin: 8px 8px 0 0; }
.sc-list { margin-top: 8px; }
.sc-row { flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 8px; border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.sc-row.mine { border-color: rgba(155, 225, 93, 0.7); background-color: rgba(155, 225, 93, 0.1); }
.sc-rank { width: 28px; font-size: 16px; -unity-font-style: bold; color: rgb(154, 166, 160); -unity-text-align: middle-center; margin-right: 8px; }
.sc-rank.top { color: rgb(255, 201, 40); }
.sc-words { flex-grow: 1; flex-shrink: 1; margin: 0 10px; min-width: 0; }
.sc-name { font-size: 16px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sc-name.none { color: rgb(154, 166, 160); -unity-font-style: italic; }
.sc-sub { font-size: 12px; color: rgb(154, 166, 160); margin-top: 2px; white-space: normal; }
.sc-dist { flex-shrink: 0; font-size: 28px; -unity-font-definition: url("Fonts/BebasNeue-Regular.ttf"); -unity-font-style: normal; }

/* ── Hats ─────────────────────────────────────────────────────────────── */
.hat-pic { width: 52px; height: 52px; margin-right: 12px; border-radius: 12px; background-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: scale-to-fit; }
.hat-face { align-items: center; margin-bottom: 4px; }
.hgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 8px; }
.hcard { width: 48.5%; margin: 0 0 10px 0; padding: 10px 8px 12px 8px; border-radius: 16px; border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1); background-color: rgba(255, 255, 255, 0.04); align-items: center; }
.hcard:hover { background-color: rgba(255, 255, 255, 0.07); }
.hcard.on { border-color: rgb(155, 225, 93); background-color: rgba(155, 225, 93, 0.12); }
.hcard-pic { width: 104px; height: 104px; border-radius: 14px; -unity-background-scale-mode: scale-to-fit; align-items: center; justify-content: center; }
.hcard.locked .hcard-pic { -unity-background-image-tint-color: rgb(120, 126, 123); opacity: 0.7; }
.hcard-none { font-size: 40px; color: rgb(154, 166, 160); }
.hcard-name { font-size: 15px; -unity-font-style: bold; margin-top: 4px; }
.hcard-boost { font-size: 12px; -unity-font-style: bold; color: rgb(155, 225, 93); -unity-text-align: middle-center; white-space: normal; margin-top: 2px; }
.hcard-sub { font-size: 12px; color: rgb(154, 166, 160); -unity-text-align: middle-center; white-space: normal; margin-top: 2px; }
.hcard.on .hcard-sub { color: rgb(155, 225, 93); -unity-font-style: bold; }
.hbar { width: 80%; height: 6px; border-radius: 99px; background-color: rgba(0, 0, 0, 0.45); margin-top: 8px; overflow: hidden; }
.hbar-fill { height: 100%; background-color: rgb(155, 225, 93); }
.hcard-n { font-size: 11px; color: rgb(154, 166, 160); margin-top: 3px; }
.r-hat { flex-direction: row; align-items: center; margin-top: 12px; padding: 10px 12px; border-radius: 14px;
    background-color: rgba(255, 201, 40, 0.12); border-width: 1px; border-color: rgba(255, 201, 40, 0.5); }
.r-hat-pic { width: 52px; height: 52px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.r-hat-t { font-size: 11px; letter-spacing: 1.5px; color: rgb(255, 201, 40); -unity-font-style: bold; }
.r-hat-n { font-size: 17px; -unity-font-style: bold; }
.r-hat-g { font-size: 12px; color: rgb(154, 166, 160); }

/* ── The evac's cut scene ─────────────────────────────────────────────── */
.curtain { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
.curtain-title { font-size: 58px; letter-spacing: 3px; color: rgb(238, 242, 236);
    -unity-font-definition: url("Fonts/BebasNeue-Regular.ttf"); -unity-font-style: normal; }
.curtain-line { font-size: 15px; color: rgb(207, 216, 210); margin-top: 4px; }
.curtain-skip { position: absolute; bottom: 48px; font-size: 13px; color: rgba(238, 242, 236, 0.55); }


/* ── Challenges in a run ──────────────────────────────────────────────── */
.p-challenges { margin-top: 18px; padding: 12px 14px 14px 14px; border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.hc-head { font-size: 12px; letter-spacing: 1.5px; -unity-font-style: bold; color: rgb(154, 166, 160); }
.hc-earned { font-size: 12px; -unity-font-style: bold; color: rgb(155, 225, 93); white-space: normal; margin-top: 3px; }
.hc-row { margin-top: 10px; }
.hc-top { flex-direction: row; justify-content: space-between; }
.hc-text { font-size: 14px; -unity-font-style: bold; color: rgb(232, 236, 230); flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hc-n { font-size: 13px; color: rgb(154, 166, 160); margin-left: 8px; flex-shrink: 0; }
.hc-bar { height: 5px; margin-top: 4px; border-radius: 99px; background-color: rgba(255, 255, 255, 0.1); overflow: hidden; }
.hc-fill { height: 100%; background-color: rgb(155, 225, 93); }
.hc-pay { font-size: 12px; color: rgb(155, 225, 93); margin-top: 3px; }

/* What a challenge paid, rising off the survivor (Hud.Challenges.cs). */
.riser { position: absolute; width: 280px; align-items: center; }
.riser-over { font-size: 12px; letter-spacing: 1.5px; -unity-font-style: bold; color: rgb(238, 242, 236);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9); }
.riser-text { font-size: 34px; letter-spacing: 1px; color: rgb(155, 225, 93); text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9); }
